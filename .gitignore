# Canonical archive bytes are acquired and verified locally, not committed.
/artifacts/**/*.rar
/artifacts/**/*.tgz
/artifacts/**/*.tar.gz
/artifacts/**/*.zip
/artifacts/**/*.part

# Extracted original trees remain local until licensing/provenance policy is finalized.
/extracted/

# R3 / R4 isolated-VM staging (binary bytes) and captured evidence — never committed
/r3-stage/
/r3-evidence/
/r4-stage/
/r4-evidence/
# Bitcoin chain: same rule -- raw captured bytes never enter the repo, only their hashes
/bitcoin-evidence/

# Redundant local bootstrap archive (scaffold is now materialized in-tree)
/original-bitcoin-laboratory-bootstrap.zip

# Generated manifests and test outputs
/manifests/LOCAL_SHA256SUMS
/reports/
/build/

# C++ port build artifacts (derivatives/)
/derivatives/**/*.exe
/derivatives/**/*.o
/derivatives/port/*_out.txt
/derivatives/port/scenario.txt
*.log
__pycache__/
.pytest_cache/
.DS_Store
reproduce-manifest.json
reproduce-claims-manifest.json

# Credentials. Added 12 Aug 2026, before any token existed rather than after one leaked:
# a bearer token is billable and identifies an account, and "it got committed" is the
# failure mode that only becomes live the moment you first hold one.
.env
.env.*
*.token
BLOCKSTREAM_TOKEN*

# retarget watcher runtime state -- a moving snapshot, not an artifact
derivatives/retarget/_retarget_watch_state.json
