    orcid: "https://orcid.org/0009-0006-9409-6534"
license: MIT
repository-code: "https://github.com/original-bitcoin-laboratory/genesis"
url: "https://bitcoin-lab.org"
keywords:
  - Bitcoin
  - blockchain
  - consensus protocols
  - reproducibility
  - software archaeology
